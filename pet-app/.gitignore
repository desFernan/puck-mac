# Xcode project is generated by `xcodegen generate` from project.yml (single
# source of truth, avoids project.pbxproj merge conflicts)
*.xcodeproj/
*.xcworkspace/
DerivedData/
*.xcuserstate
*.xcscmblueprint
.swiftpm/

# Build output, including the .dmg scripts/make-dmg.sh writes
build/

# Info.plist is generated by xcodegen from project.yml's info.properties
Puck/Resources/Info.plist
PuckClient/Resources/Info.plist
