# Avatar/sound binary assets are tracked with Git LFS (02_pet-app.md "협업 규칙" / collaboration rules)
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text

# Avatar sprite art: same rule as the other binaries above. The dummy pack
# alone is ~19MB of PNG, which does not belong in git history directly.
*.png filter=lfs diff=lfs merge=lfs -text
