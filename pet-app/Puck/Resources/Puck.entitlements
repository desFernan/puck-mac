<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- run_applescript targets other apps (F11 / protocol section 4). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- F7 PTT records through AVAudioEngine. Hardened runtime blocks
	     microphone access without this even once the user has granted the TCC
	     permission, and the request comes back denied with no visible prompt. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
